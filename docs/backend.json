{
  "entities": {
    "IPO": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "IPO",
      "type": "object",
      "description": "Represents an upcoming Initial Public Offering.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the IPO entity." },
        "companyName": { "type": "string", "description": "Name of the company going public." },
        "symbol": { "type": "string", "description": "Ticker symbol for the stock." },
        "logoUrl": { "type": "string", "description": "URL for the company's logo." },
        "market": { "type": "string", "description": "The stock exchange where the IPO will be listed." },
        "ipoDate": { "type": "string", "format": "date-time", "description": "Scheduled date of the IPO." },
        "priceRange": { "type": "array", "items": { "type": "number" }, "description": "Expected price range for the IPO shares." },
        "sharesOffered": { "type": "number", "description": "Number of shares being offered." },
        "dealSize": { "type": "number", "description": "Total value of the IPO offering." },
        "description": { "type": "string", "description": "A brief description of the company." },
        "industry": { "type": "string", "description": "The industry sector the company belongs to." },
        "predictionScore": { "type": "number", "description": "AI-driven score for potential performance." },
        "successProbability": { "type": "number", "description": "AI-calculated probability of success." },
        "expectedReturn": { "type": "number", "description": "AI-calculated expected percentage return." },
        "shapExplanations": { "type": "object", "additionalProperties": { "type": "number" }, "description": "SHAP values explaining the prediction." },
        "naturalLanguageExplanation": { "type": "string", "description": "A human-readable summary of the AI analysis." },
        "newsSentiment": {
          "type": "object",
          "properties": {
            "aggregatedScore": { "type": "number" },
            "positiveHeadlines": { "type": "array", "items": { "type": "object", "properties": { "source": { "type": "string" }, "title": { "type": "string" } } } },
            "negativeHeadlines": { "type": "array", "items": { "type": "object", "properties": { "source": { "type": "string" }, "title": { "type": "string" } } } }
          }
        },
        "promoterHoldingPost": { "type": "number" },
        "revenueTtm": { "type": "number" },
        "profitMargin": { "type": "number" },
        "roe": { "type": "number" },
        "debtToEquity": { "type": "number" },
        "qibSubscription": { "type": "number" },
        "niiSubscription": { "type": "number" },
        "retailSubscription": { "type": "number" },
        "gmp": { "type": "number" }
      },
      "required": ["id", "companyName", "symbol", "ipoDate", "predictionScore"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user (Firebase UID)." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "URL of the user's profile picture." },
        "stripeCustomerId": { "type": "string", "description": "Stripe customer ID for billing." },
        "proStatus": { "type": "boolean", "description": "True if the user has an active Pro subscription." }
      },
      "required": ["id", "email"]
    },
    "SavedStrategy": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SavedStrategy",
      "type": "object",
      "description": "Represents a user's saved IPO investment strategy.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the saved strategy." },
        "userId": { "type": "string", "description": "ID of the user who owns the strategy." },
        "strategyName": { "type": "string", "description": "Name given to the strategy." },
        "rules": { "type": "array", "items": { "type": "object" }, "description": "The set of rules that define the strategy." }
      },
      "required": ["id", "userId", "strategyName"]
    }
  },
  "firestore": {
    "/ipos/{ipoId}": {
      "schema": { "$ref": "#/entities/IPO" },
      "description": "Collection of all IPO documents. Publicly readable."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profile documents. Only accessible by the owner."
    },
    "/users/{userId}/savedStrategies/{strategyId}": {
      "schema": { "$ref": "#/entities/SavedStrategy" },
      "description": "Sub-collection of strategies saved by a specific user."
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  }
}
