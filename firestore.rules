rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // IPOs: Publicly readable, only writable by authenticated users (for seeding/admin).
    match /ipos/{ipoId} {
      allow read: if true;
      allow write: if isSignedIn(); // For now, any signed-in user can write. Refine for admin roles later.
    }

    // User profiles: Only the owner can read or write their own profile.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Saved Strategies: Only the owner can manage their own strategies.
      match /savedStrategies/{strategyId} {
        allow read, list, create, update, delete: if isOwner(userId);
      }
    }
  }
}
