/**
 * Core Philosophy: This ruleset enforces a strict security model that segregates public data from private user-specific data.
 * Public information, such as the IPO list, is readable by anyone, but write access is disabled pending the implementation of an admin role.
 * All user-specific data, such as profiles and saved strategies, is strictly confined to the authenticated owner of that data.
 *
 * Data Structure: The data is organized into two main top-level collections:
 * 1. `/ipos/{ipoId}`: A flat collection for publicly readable IPO data.
 * 2. `/users/{userId}`: A collection where each document represents a user profile. All private user data, like `/savedStrategies`, is nested within their user document, creating a clear ownership hierarchy.
 *
 * Key Security Decisions:
 * - Public vs. Private: A clear separation is maintained between the public `/ipos` collection and the private `/users` collection. This prevents accidental data leakage and simplifies list queries.
 * - User Data Privacy: A user can only access data under their own `/users/{userId}` path. Listing users is explicitly disallowed to protect user privacy.
 * - Ownership Enforcement: All write operations on user-owned data (`create`, `update`, `delete`) are strictly limited to the authenticated owner.
 * - Write Lock-down on Public Data: Writes to the `/ipos` collection are currently disabled (`allow write: if false;`). This is a security precaution because the `IPO` data model lacks an `ownerId` or `authorId` field, making it impossible to validate who is authorized to write data. This must be addressed by the development team.
 *
 * Denormalization for Authorization: To ensure fast and secure access control without costly `get()` calls, the `SavedStrategy` documents under `/users/{userId}/savedStrategies/{strategyId}` contain a denormalized `userId` field. This allows rules to validate ownership directly from the document's data during creation and updates.
 *
 * Structural Segregation: User-specific data (`savedStrategies`) is stored in a subcollection under the user's document (`/users/{userId}`). This is a superior pattern to a single top-level `savedStrategies` collection with a `userId` field, as it makes security rules for list operations simpler and more secure.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //----------------------------------------------------------------//
    // Helper Functions
    //----------------------------------------------------------------//

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the primary function for enforcing data ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if a document exists before an update or delete operation.
     * This prevents requests from modifying or deleting non-existent data.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Combines ownership check with an existence check for update/delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }

    /**
     * Validates a user is creating their own profile document.
     * Ensures the document ID in the data matches the user's auth UID for integrity.
     */
    function isCreatingOwnProfile(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * Validates a user is updating their own profile document.
     * Enforces that the unique user ID within the document cannot be changed.
     */
    function isUpdatingOwnProfile(userId) {
      return isExistingOwner(userId) && request.resource.data.id == resource.data.id;
    }

    /**
     * Validates a user is creating a strategy within their own data tree.
     * Ensures the denormalized `userId` in the new document matches the user's auth UID.
     */
    function isCreatingOwnStrategy(userId) {
      return isOwner(userId) && request.resource.data.userId == userId;
    }

    /**
     * Validates a user is updating their own strategy.
     * Enforces that the ownership link (`userId` field) is immutable.
     */
    function isUpdatingOwnStrategy(userId) {
      return isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
    }


    //----------------------------------------------------------------//
    // Collection: ipos
    //----------------------------------------------------------------//

    /**
     * @description Publicly readable collection of IPOs. Writes are disabled.
     * @path /ipos/{ipoId}
     * @allow (get, list) An anonymous or authenticated user retrieving IPO data.
     * @deny (create, update, delete) Any user attempting to modify the IPO list.
     * @principle Public read access for global data, with writes locked down until an admin/ownership model is implemented.
     */
    match /ipos/{ipoId} {
      allow get: if true;
      allow list: if true;

      // CRITICAL: Cannot implement owner-only writes. The 'IPO' entity is missing an 'ownerId' or 'authorId' field.
      // Writes are disabled to prevent unauthorized data modification.
      allow create: if false; // TODO: Add admin role or owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add admin role or owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add admin role or owner validation once the schema is updated with an ownership field.
    }


    //----------------------------------------------------------------//
    // Collection: users
    //----------------------------------------------------------------//

    /**
     * @description A user's own profile document.
     * @path /users/{userId}
     * @allow (get, create, update, delete) A user accessing their OWN profile document (e.g., /users/abc reading data where their auth.uid is 'abc').
     * @deny (get) A user trying to read another user's profile (e.g., user 'xyz' reading /users/abc).
     * @deny (list) Any user trying to list all documents in the /users collection.
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isCreatingOwnProfile(userId);
      allow update: if isUpdatingOwnProfile(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * @description A user's private collection of saved trading strategies.
       * @path /users/{userId}/savedStrategies/{strategyId}
       * @allow (get, list, create, update, delete) A user managing strategies within their own profile (e.g., user 'abc' accessing /users/abc/savedStrategies/...).
       * @deny (get, list, create, update, delete) A user trying to access another user's strategies (e.g., user 'xyz' accessing /users/abc/savedStrategies/...).
       * @principle Enforces document ownership for all operations within a user-specific subcollection.
       */
      match /savedStrategies/{strategyId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isCreatingOwnStrategy(userId);
        allow update: if isUpdatingOwnStrategy(userId);
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}